{
  "name": "dms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:parity": "vitest run",
    "test:parity:all": "vitest run --config vitest.parity-all.config.ts",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @dms/db run generate",
    "db:migrate": "pnpm --filter @dms/db run migrate",
    "db:seed": "pnpm --filter @dms/db run seed",
    "debug": "tsx packages/devtools/src/cli.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "supertest": "^7.3.0",
    "swr": "2.5.1",
    "tsx": "^4.20.3",
    "turbo": "^2.0.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
