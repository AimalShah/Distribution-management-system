{
  "name": "dms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:parity": "vitest run",
    "test:parity:all": "vitest run --config vitest.parity-all.config.ts",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @dms/db run generate",
    "db:migrate": "pnpm --filter @dms/db run migrate",
    "db:seed": "pnpm --filter @dms/db run seed",
    "db:wipe": "pnpm --filter @dms/db run wipe",
    "debug": "tsx packages/devtools/src/cli.ts"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^7.3.0",
    "turbo": "^2.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
