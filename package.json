{
  "name": "dms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @dms/web build",
    "lint": "turbo run lint && oxlint",
    "test": "turbo run test",
    "qa": "node scripts/qa/run.mjs",
    "test:qa:domain": "vitest run --config vitest.qa.config.ts",
    "test:parity": "vitest run",
    "test:parity:all": "vitest run --config vitest.parity-all.config.ts",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @dms/db run generate",
    "db:migrate": "pnpm --filter @dms/db run migrate",
    "db:migrate:deploy": "pnpm --filter @dms/db run migrate:deploy",
    "db:seed": "pnpm --filter @dms/db run seed",
    "db:seed:owner": "pnpm --filter @dms/db run seed:owner",
    "db:seed:stress": "pnpm --filter @dms/db run seed:stress",
    "db:wipe": "pnpm --filter @dms/db run wipe",
    "debug": "tsx packages/devtools/src/cli.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^6.0.2",
    "oxlint": "1.87.0",
    "papaparse": "^5.7.0",
    "playwright": "1.62.1",
    "supertest": "^7.3.0",
    "tsx": "^4.20.3",
    "turbo": "^2.0.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
