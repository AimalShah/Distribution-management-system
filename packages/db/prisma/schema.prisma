generator client {
  provider = "prisma-client-js"
  output   = "./generated/"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  members        Member[]
  invitations    Invitation[]
  organizationId String?

  isOwner        Boolean?
  isFormComplete Boolean?
  inventoryLogs  InventoryLog[]

  returns    Return[]
  payments   Payment[]
  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  members     Member[]
  invitations Invitation[]
  Products    Product[]
  Purchases   Purchase[]
  Sales       Sale[]
  Returns     Return[]
  Suppliers   Supplier[]
  Customers   Customer[]
  Categories  Category[]
  Brands      Brand[]
  Inventory   Inventory[]
  Payments    Payment[]
  roles       Role[]
  batches     StockBatch[]
  settings    CompanySettings?

  @@map("organization")
}

/**
 * The per-Company configuration the client edits: the profile printed on
 * documents, the SKU format new products are generated from, the return policy,
 * and the default credit term. One row per Company, created lazily on first
 * read so an organization that predates this model still works.
 */
model CompanySettings {
  id             String @id @default(cuid())
  organizationId String @unique

  displayName String?
  address     String?
  gstin       String?

  // SKU generation (ADR 0007). `skuSequence` is the last sequence number
  // handed out; it only ever moves forward, so deleting a product never frees
  // its number for reuse.
  skuFormat    String @default("{BRAND}-{CATEGORY}-{SEQ:5}")
  skuSeparator String @default("-")
  skuSequence  Int    @default(0)

  // Return policy (ADR 0008).
  returnWindowDays Int     @default(30)
  returnsEnabled   Boolean @default(true)

  // Credit terms (ADR 0009).
  creditTermDays Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  roleId         String?
  customRole     Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt      DateTime

  // One membership per user per organization, enforced by the database. The
  // read-then-create check in `addMember` cannot make this true on its own: two
  // concurrent requests both see no existing row and both insert. Duplicate owner
  // rows are not merely untidy -- `countOwners` counts rows, not distinct users,
  // so a tenant with one real owner and two owner rows reports two owners and the
  // LAST_OWNER guard lets both be demoted away, leaving the organization with no
  // owner and no route to appoint one.
  @@unique([organizationId, userId])
  @@map("member")
}

model Role {
  id             String           @id @default(cuid())
  name           String
  description    String?
  organizationId String
  isSystem       Boolean          @default(false)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  members        Member[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([name, organizationId])
  @@map("role")
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  resource  String
  action    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([roleId, resource, action])
  @@map("role_permission")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  // Required by better-auth's organization plugin (checkpoint 3), which writes it
  // on every invitation. The default only covers rows that predate the plugin.
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Supplier {
  id             String @id @default(cuid())
  supplierCode   String @unique
  organizationId String

  contactPerson String
  companyName   String
  email         String?
  phone         String?
  address       String?
  city          String?
  isActive      Boolean      @default(true)
  purchase      Purchase[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id])

  @@map("supplier")
}

model Customer {
  id             String @id @default(cuid())
  customerCode   String @unique
  organizationId String

  name         String
  email        String?
  phone        String?
  address      String?
  city         String?
  creditLimit  Float?
  // Per-customer override of the Company's default credit term (ADR 0009).
  creditTermDays Int?
  isActive     Boolean      @default(true)
  sale         Sale[]
  payments     Payment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  //Relations
  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("customer")
}

model Product {
  id             String @id @default(cuid())
  productCode    String @unique
  organizationId String

  name        String
  description String?
  categoryId  String
  brandId     String
  unit        String // e.g., 'box', 'piece', etc.
  unitPrice   Float // base/unit price
  unitCost    Float
  isActive    Boolean  @default(true)
  gstApplicable Boolean @default(true)
  gstRate       Float   @default(0) // GST rate in percentage (e.g., 18 for 18%)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  brand         Brand          @relation(fields: [brandId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  inventory     Inventory?     @relation("ProductInventory")
  logs          InventoryLog[] @relation("ProductLogs")
  returnItems   ReturnItem[]
  batches       StockBatch[]
  organization  Organization   @relation(fields: [organizationId], references: [id])

  @@map("products")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseCode   String         @unique
  organizationId String
  supplierId     String
  totalAmount    Float
  taxAmount      Float?
  discount       Float?
  status         String // e.g. 'Pending', 'Completed'
  purchaseDate   DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  // Relations
  organization   Organization   @relation(fields: [organizationId], references: [id])
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  purchaseItems  PurchaseItem[]
  // Purchase returns point back at the receipt the goods are going out on.
  returns        Return[]

  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String
  productId   String
  quantity    Int
  unitCost    Float
  totalCost   Float
  batchNumber String?
  expiryDate  DateTime?
  taxPercent  Float?
  discount    Float?

  // Relations
  purchase Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product      @relation(fields: [productId], references: [id])
  batches  StockBatch[]

  @@map("purchase_items")
}

model Sale {
  id             String @id @default(cuid())
  saleCode       String @unique
  customerId     String
  organizationId String

  totalAmount  Float
  taxAmount    Float?
  discount     Float?
  status       String // 'Pending', 'Completed', 'Cancelled'
  invoiceType  String   @default("regular") // "regular" | "tax"
  isInterState Boolean  @default(false)
  cgstAmount   Float    @default(0)
  sgstAmount   Float    @default(0)
  igstAmount   Float    @default(0)
  saleDate     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The date this credit sale's balance becomes payable, derived from the
  // customer's credit term (ADR 0009). Null on a cash sale.
  dueDate DateTime?

  // Sum of the payments allocated to this invoice, maintained inside the same
  // transaction that writes the Payment row, so `amountPaid <= totalAmount` can
  // be guarded with one conditional update instead of a read-then-write.
  amountPaid Float @default(0)

  // What the invoice was before it was cancelled, so un-cancel puts back the
  // status it had rather than guessing between Pending and Completed.
  statusBeforeCancel String?

  // Soft delete (checkpoint 14). A deleted invoice keeps its lines and its
  // payment history; only the stock it consumed is reversed, and restore
  // re-consumes it under an availability check.
  deletedAt DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])

  customer Customer   @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  // Sale returns point back at the invoice the goods came off.
  returns  Return[]
  payments Payment[]

  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id         String @id @default(cuid())
  saleId     String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  taxPercent Float?
  discount   Float?
  batchId    String?

  cgstRate   Float @default(0)
  sgstRate   Float @default(0)
  igstRate   Float @default(0)
  cgstAmount Float @default(0)
  sgstAmount Float @default(0)
  igstAmount Float @default(0)

  // Relations
  sale    Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
  batch   StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@map("sale_items")
}

model Category {
  id             String @id @default(cuid())
  name           String
  organizationId String

  // Short code used to build a product's SKU (ADR 0007); blank falls back to
  // the name's first letters.
  shortCode    String?
  description  String?
  products     Product[]
  brands       Brand[]
  organization Organization @relation(fields: [organizationId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([name, organizationId])
  @@map("category")
}

model Brand {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  categoryId     String
  // Short code used to build a product's SKU (ADR 0007).
  shortCode      String?
  description    String?
  products       Product[]
  category       Category     @relation(fields: [categoryId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([name, categoryId, organizationId])
  @@map("brand")
}

model Inventory {
  id             String @id @default(cuid())
  productId      String @unique
  organizationId String

  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  reorderLevel     Int            @default(0)
  maxStockLevel    Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  // Relations
  product          Product        @relation("ProductInventory", fields: [productId], references: [id], onDelete: Cascade)
  logs             InventoryLog[]
  organization     Organization   @relation(fields: [organizationId], references: [id])

  @@index([productId])
  @@index([quantityOnHand])
  @@map("inventory")
}

model InventoryLog {
  id           String            @id @default(cuid())
  inventoryId  String
  productId    String
  userId       String
  movementType InventoryMovement
  quantity     Int
  previousQty  Int
  newQty       Int
  reason       String?
  reference    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  // Relations
  inventory    Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product      Product           @relation("ProductLogs", fields: [productId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@index([movementType])
  @@map("inventory_logs")
}

enum InventoryMovement {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RETURN
  DAMAGED
  EXPIRED
}

model Return {
  id             String @id @default(cuid())
  returnCode     String @unique
  organizationId String

  returnType ReturnType
  returnDate DateTime     @default(now())
  reason     String?
  userId     String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // The document the goods are going back against. `src/actions/return.ts`
  // already asked the form for these and `addReturn` then dropped them on the
  // floor, so a SALE return could not be checked against the invoice it claimed
  // to be reversing and nothing tied the return to a customer. Both stay
  // optional because EXPIRED and DAMAGED returns are not tied to a document.
  saleId     String?
  purchaseId String?

  // Soft delete (checkpoint 14): DELETE reverses the stock and stamps this
  // column instead of removing the row, so the audit trail survives and a
  // restore can re-apply the movement under an availability check.
  deletedAt DateTime?

  user         User         @relation(fields: [userId], references: [id])
  items        ReturnItem[]
  organization Organization @relation(fields: [organizationId], references: [id])
  sale         Sale?        @relation(fields: [saleId], references: [id])
  purchase     Purchase?    @relation(fields: [purchaseId], references: [id])

  // Every return against one document has to be summed before the next is
  // allowed, so both sides of that sum are read by document.
  @@index([saleId])
  @@index([purchaseId])
  @@map("returns")
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Int
  taxAmount Float
  discount  Float
  unitPrice Float
  note      String?
  // The condition gate (ADR 0008): a restockable line goes back on the shelf, a
  // damaged one is credited but not put back on hand. `reason` says why *this*
  // line is in that condition, alongside the header's overall reason.
  condition ReturnCondition @default(RESTOCKABLE)
  reason    String?
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("return_items")
}

enum ReturnCondition {
  RESTOCKABLE
  DAMAGED
}

/**
 * Money received from a customer (checkpoint 15).
 *
 * `saleId` is optional on purpose: an allocated payment settles one invoice and
 * is what moves `Sale.amountPaid`, while an unallocated payment is cash on the
 * customer's account and appears on the ledger as a receipt without touching any
 * invoice. Both are the same record, so a statement shows them side by side.
 *
 * Correction is a soft delete too -- `deletedAt` -- because a payment that
 * vanished would make the ledger stop reconciling against reality.
 */
model Payment {
  id             String  @id @default(cuid())
  paymentCode    String  @unique
  organizationId String
  customerId     String
  saleId         String?

  amount   Float
  method   String // 'Cash', 'Bank Transfer', 'Mobile Wallet', 'Cheque', 'Other'
  reference String?
  note     String?
  paidAt   DateTime @default(now())
  userId   String

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  // SetNull rather than a cascade: a fixture tearing down a hard-deleted sale
  // should leave the money record on the customer's account, not swallow it.
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([saleId])
  @@map("payments")
}

enum ReturnType {
  SALE
  PURCHASE
  EXPIRED
  DAMAGED
}

model StockBatch {
  id                String    @id @default(cuid())
  productId         String
  organizationId    String
  batchNumber       String
  expiryDate        DateTime?
  quantityRemaining Int       @default(0)
  quantityReceived  Int       @default(0)
  unitCost          Float     @default(0)
  purchaseItemId    String?
  receivedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  saleItems    SaleItem[]

  @@unique([productId, batchNumber, organizationId])
  @@index([organizationId, expiryDate])
  @@map("stock_batches")
}
