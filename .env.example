# Local development database. Not committed -- `.gitignore` covers `.env*`.
#
# Generated for this workstation's PostgreSQL 16 instance. `dms_test` is what the
# checkpoint parity suite and `prisma migrate deploy` run against.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms_test?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/dms_test?schema=public"

# Neon Serverless Postgres (production / staging cloud hosting - see docs/adr/0012)
# DATABASE_URL="postgresql://<user>:<password>@<ep-xyz>-pooler.<region>.neon.tech/<dbname>?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<ep-xyz>.<region>.neon.tech/<dbname>?sslmode=require"
#
# Interactive transaction options (milliseconds). Defaults to 30000ms (timeout) and 10000ms (maxWait).
# Useful when using remote/cloud databases (e.g. Neon) over higher-latency connections.
# PRISMA_TRANSACTION_TIMEOUT="30000"
# PRISMA_TRANSACTION_MAX_WAIT="10000"


# Auth (checkpoint 3 - Better-Auth). BETTER_AUTH_SECRET is required in production -- the server
# refuses to start without one of at least 32 characters. Generate with
# `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
# Comma-separated. Defaults to the CORS allowlist (DMS_ALLOWED_ORIGINS).
TRUSTED_ORIGINS="http://localhost:5173"
# "false" lets users sign in without verifying their email. Leave it on in
# production, with RESEND_API_KEY set so the verification email is actually sent.
REQUIRE_EMAIL_VERIFICATION="false"
RESEND_API_KEY=""
# Comma-separated user ids granted the global admin role, for bootstrapping the
# first administrator.
DMS_ADMIN_USER_IDS=""
# Only behind a gateway that authenticates every request and sets the
# x-organization-id / x-user-id / x-session-id headers itself.
# DMS_TRUSTED_PROXY_AUTH="true"

