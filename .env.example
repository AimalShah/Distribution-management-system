# Local development database. Not committed -- `.gitignore` covers `.env*`.
#
# Generated for this workstation's PostgreSQL 16 instance. `dms_test` is what the
# checkpoint parity suite and `prisma migrate deploy` run against.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms_test?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/dms_test?schema=public"

# Sign-in for the web app. Each has a built-in default, so these are only set
# to change them -- the login page offers admin / admin123 until you do.
# DMS_AUTH_USERNAME="admin"
# DMS_AUTH_PASSWORD="admin123"
# DMS_AUTH_NAME="Administrator"
# Secret the session token is signed with. Set this to a random string in any
# deployment that is reachable from outside your machine.
# DMS_AUTH_SECRET="change-me"
