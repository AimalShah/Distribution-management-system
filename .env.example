# Local development database. Not committed -- `.gitignore` covers `.env*`.
#
# Generated for this workstation's PostgreSQL 16 instance. `dms_test` is what the
# checkpoint parity suite and `prisma migrate deploy` run against.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms_test?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/dms_test?schema=public"

# Neon Serverless Postgres (production / staging cloud hosting - see docs/adr/0012)
# DATABASE_URL="postgresql://<user>:<password>@<ep-xyz>-pooler.<region>.neon.tech/<dbname>?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<ep-xyz>.<region>.neon.tech/<dbname>?sslmode=require"
#
# Interactive transaction options (milliseconds). Defaults to 30000ms (timeout) and 10000ms (maxWait).
# Useful when using remote/cloud databases (e.g. Neon) over higher-latency connections.
# PRISMA_TRANSACTION_TIMEOUT="30000"
# PRISMA_TRANSACTION_MAX_WAIT="10000"


# Auth (checkpoint 3 - Better-Auth). BETTER_AUTH_SECRET is required in production -- the server
# refuses to start without one of at least 32 characters. Generate with
# `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
# Comma-separated list of browser origins allowed to call the API with
# credentials (and Better-Auth's trusted origins). In development the server
# falls back to localhost defaults; in production list every origin the web app
# is served from here.
# DMS_ALLOWED_ORIGINS="https://am-enterprise.org"
# Comma-separated. Usually the same values as DMS_ALLOWED_ORIGINS; kept separate
# because Better-Auth redirects/CSRF checks treat origins slightly differently.
TRUSTED_ORIGINS="http://localhost:5173"
# Server port and bind address (defaults: 4000, 127.0.0.1 in dev / 0.0.0.0 in production).
# PORT="4000"
# DMS_HOST="0.0.0.0"
# "true" lets users sign in without verifying their email. Leave it ON (this
# file must keep the safer default) in production, with RESEND_API_KEY set so
# the verification email is actually sent. Disabling verification in production
# means anyone can claim any address, including an owner's.
REQUIRE_EMAIL_VERIFICATION="true"
RESEND_API_KEY=""
# From-address for Better-Auth emails. Hosted production should use your
# verified sending domain; Resend only delivers `onboarding@resend.dev` to the
# account owner as a test.
# EMAIL_FROM="AM-Enterprise <no-reply@am-enterprise.org>"
# Override for one deliberate destructive run (db:wipe / db:seed / db:seed:owner /
# db:seed:stress) against a hosted database. These scripts refuse anything that
# is not localhost otherwise. It is never silent: the host being acted on is
# printed, read it before confirming.
# DMS_ALLOW_DESTRUCTIVE="true"
# Path to a Chromium/Chrome binary for server-side PDF rendering; Puppeteer
# skips its bundled-Chromium download when one is already installed.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome"
# Comma-separated user ids granted the global admin role, for bootstrapping the
# first administrator.
DMS_ADMIN_USER_IDS=""
# Only behind a gateway that authenticates every request and sets the
# x-organization-id / x-user-id / x-session-id headers itself.
# DMS_TRUSTED_PROXY_AUTH="true"
# How many reverse-proxy layers sit in front of the API ("true" = one, or an
# integer). Without it, behind Render/load balancers, rate limiting and the
# session audit's recorded IP key on the proxy's address instead of clients'.
# DMS_TRUST_PROXY="true"

# ── Web app (`apps/web`, Vite) ────────────────────────────────────────────────
# Baked into the production bundle at build time (Vite), not read at runtime.
# The API origin the web app calls; defaults to a relative "/api" in dev.
# VITE_API_URL="https://am-enterprise.org/api"

