# ==============================================================================
# DMS FRONTEND PRODUCTION ENVIRONMENT (.env.production)
# Target: Cloudflare Workers / Static Hosting (@dms/web)
# Note: Variables starting with VITE_ are embedded into the client bundle at build time.
# ==============================================================================

# Public API endpoint (replace <your-new-service-name> with your new Render service name)
VITE_API_URL=https://<your-new-service-name>.onrender.com/api

# Public Server base URL (origin only, without /api)
VITE_SERVER_URL=https://<your-new-service-name>.onrender.com
