# ==============================================================================
# DMS FRONTEND PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Target: Cloudflare Workers / Static Hosting (@dms/web)
# Note: Variables starting with VITE_ are embedded into the client bundle at build time.
# ==============================================================================

# Public API endpoint (ending with /api)
VITE_API_URL=https://<your-service-name>.onrender.com/api

# Public Server base URL (origin only, without /api)
VITE_SERVER_URL=https://<your-service-name>.onrender.com
