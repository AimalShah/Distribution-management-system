{
  "name": "@dms/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:checkpoint2a": "vitest run src/routes/product.test.ts",
    "test:checkpoint2b": "vitest run src/routes/purchase.test.ts",
    "test:checkpoint2c": "vitest run src/routes/sale.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dms/db": "workspace:*",
    "@dms/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@dms/config-typescript": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
