# ==============================================================================
# DMS BACKEND PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Target: Render Web Service (@dms/server)
# ==============================================================================

NODE_ENV=production
PORT=10000
DMS_HOST=0.0.0.0

# ── Database (Neon Serverless PostgreSQL) ─────────────────────────────────────
# Pooled connection string used by Express server for standard application queries
DATABASE_URL="postgresql://<user>:<password>@<ep-xyz>-pooler.<region>.neon.tech/<dbname>?sslmode=require"

# Direct unpooled connection string used by Prisma during migrations (`prisma migrate deploy`)
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<ep-xyz>.<region>.neon.tech/<dbname>?sslmode=require"

# Interactive transaction timeouts for cloud/serverless database latency (milliseconds)
PRISMA_TRANSACTION_TIMEOUT=30000
PRISMA_TRANSACTION_MAX_WAIT=10000

# ── Authentication (Better-Auth) ──────────────────────────────────────────────
# 32+ character signing secret (mandatory in production; generate via `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Public auth base URL (where the backend API or app is reached)
BETTER_AUTH_URL="https://<your-service-name>.onrender.com"

# ── CORS & Security ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend browser origins
DMS_ALLOWED_ORIGINS="https://am-enterprise.org,https://www.am-enterprise.org"
TRUSTED_ORIGINS="https://am-enterprise.org,https://www.am-enterprise.org"

# Required behind Render's reverse proxy for correct rate limiting & client IP attribution
DMS_TRUST_PROXY="true"

# ── Email Service (Resend) ───────────────────────────────────────────────────
# Enforce email verification on signup in production
REQUIRE_EMAIL_VERIFICATION="true"
RESEND_API_KEY=""
EMAIL_FROM="AM-Enterprise <no-reply@am-enterprise.org>"

# ── PDF Generation ────────────────────────────────────────────────────────────
# Optional: Path to Chrome/Chromium executable if installed on host system
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome"
