sequenceDiagram
  autonumber
  participant C as Client
  participant BA as better-auth
  participant M as sessionAuthContext
  participant DB as Prisma

  C->>BA: GET /api/auth/get-session (cookie | Bearer)
  BA-->>M: session { activeOrganizationId, user }
  alt no session cookie, Bearer present
    M->>M: verifySessionToken(bearer)
    M->>DB: organization.findFirst / user.findFirst(isOwner)
    M->>M: synthesize dev session
  end
  M->>M: organizationId = session.activeOrganizationId
  alt no active org
    M-->>C: 400 ORGANIZATION_REQUIRED
  end
  M->>DB: member.findUnique(organizationId_userId)
  alt not a member
    M-->>C: 403 NOT_A_MEMBER
  end
  M->>M: req.auth = { organizationId, userId, sessionId }
