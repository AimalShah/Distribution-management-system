      +updateSale(id, data, organizationId)
      +deleteSale(id, organizationId, userId)
      +restoreSale(id, organizationId, userId)
      +cancelSale(id, organizationId)
      +uncancelSale(id, organizationId)
      +getSaleInvoiceData(id, organizationId)
    }
    class PaymentService {
      +getPayments(args)
      +getPaymentById(id, organizationId)
      +createPayment(data, organizationId, userId)
      +deletePayment(id, organizationId)
    }
    class PurchaseService {
      +calculatePurchaseTotal(data: PurchaseFormInput)
      +getPurchases(args: PurchaseListArgs)
      +getPurchasesBySupplier(args)
      +getPurchaseById(id, organizationId)
      +createPurchase(data, organizationId, userId)
      +updatePurchase(id, data, organizationId)
      +deletePurchase(id, organizationId)
